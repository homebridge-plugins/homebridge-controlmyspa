{
  "name": "@homebridge-plugins/homebridge-controlmyspa",
  "displayName": "Homebridge ControlMySpa",
  "type": "module",
  "version": "1.1.0",
  "description": "The ControlMySpa plugin allows you to access your Balboa ControlMySpa hot tub from HomeKit.",
  "author": {
    "name": "bwp91",
    "email": "bwp91@icloud.com"
  },
  "license": "ISC",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/bwp91"
    },
    {
      "type": "kofi",
      "url": "https://ko-fi.com/bwp91"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/BenPotter"
    }
  ],
  "homepage": "https://github.com/homebridge-plugins/homebridge-controlmyspa",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-controlmyspa.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-controlmyspa/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "controlmyspa",
    "balboa",
    "spa",
    "hot tub"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc && npm run plugin-ui",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "changelog:sync": "node .github/scripts/sync-changelog.mjs"
  },
  "allowScripts": {
    "fsevents": true
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "homebridge": "^2.2.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
