{
  "pluginAlias": "ControlMySpa",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "headerDisplay": "<p align='center'><img width='250px' src='https://raw.githubusercontent.com/homebridge-plugins/homebridge-controlmyspa/latest/branding/Homebridge_x_ControlMySpa.png'></p>\n\nThe **ControlMySpa** plugin allows you to control your Balboa ControlMySpa hot tub from HomeKit. To get started link your ControlMySpa account below.",
  "footerDisplay": "Your spa must be connected to the ControlMySpa cloud and working in the ControlMySpa app before using this plugin.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "default": "ControlMySpa"
      },
      "credentials": {
        "type": "object",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string",
            "x-schema-form": {
              "type": "email"
            },
            "description": "The email for your ControlMySpa account."
          },
          "password": {
            "title": "Password",
            "type": "string",
            "x-schema-form": {
              "type": "password"
            },
            "description": "The password for your ControlMySpa account."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spaId": {
                  "title": "Spa ID",
                  "type": "string",
                  "description": "The spa's ID as shown in the Homebridge log at startup."
                },
                "configDeviceName": {
                  "title": "Device Name",
                  "type": "string",
                  "placeholder": "Hot Tub",
                  "description": "A custom name for this spa in HomeKit.",
                  "condition": {
                    "functionBody": "return (model.options && model.options.devices && model.options.devices[arrayIndices].spaId);"
                  }
                },
                "hide_device": {
                  "title": "Hide Device",
                  "type": "boolean",
                  "description": "If enabled, this spa will not be shown in HomeKit.",
                  "condition": {
                    "functionBody": "return (model.options && model.options.devices && model.options.devices[arrayIndices].spaId);"
                  }
                },
                "hideEnergy": {
                  "title": "Hide Energy",
                  "type": "boolean",
                  "description": "If enabled, this spa gets no energy accessory when energy reporting is on.",
                  "condition": {
                    "functionBody": "return (model.options && model.options.devices && model.options.devices[arrayIndices].spaId && !model.options.devices[arrayIndices].hide_device && model.options.energy && model.options.energy.enabled);"
                  }
                },
                "showPanelLock": {
                  "title": "Show Panel Lock",
                  "type": "boolean",
                  "default": false,
                  "description": "If enabled, a lock is shown in HomeKit to lock and unlock the spa's physical control panel.",
                  "condition": {
                    "functionBody": "return (model.options && model.options.devices && model.options.devices[arrayIndices].spaId && !model.options.devices[arrayIndices].hide_device);"
                  }
                },
                "firmware": {
                  "title": "Firmware Override",
                  "type": "string",
                  "description": "Overrides the firmware version shown in HomeKit.",
                  "condition": {
                    "functionBody": "return (model.options && model.options.devices && model.options.devices[arrayIndices].spaId && !model.options.devices[arrayIndices].hide_device);"
                  }
                }
              }
            }
          },
          "refreshRate": {
            "title": "Refresh Rate",
            "type": "number",
            "minimum": 30,
            "maximum": 2073600,
            "placeholder": 60,
            "description": "How often, in seconds, the plugin fetches the latest spa state from the ControlMySpa cloud. Default is 60, minimum is 30."
          },
          "recordHistory": {
            "title": "Record History",
            "type": "boolean",
            "default": true,
            "description": "Keep 30 days of water temperature, estimated energy, and when the jets, blower, heater and filter cycles ran, for the Dashboard tab on this page. Turn off to stop recording; the history already kept stays until it ages out."
          },
          "logging": {
            "title": "Plugin Logging Level",
            "description": "None turns off all messages from this plugin. Standard shows normal activity, warnings and errors. Debug adds detailed messages, and is what to use when reporting a problem. Default behaves the same as Standard, and also shows debug messages when Homebridge's own debug mode is on.",
            "type": "string",
            "default": "default",
            "oneOf": [
              {
                "title": "Default (follows the Homebridge debug setting)",
                "enum": ["default"]
              },
              {
                "title": "None",
                "enum": [
                  "none"
                ]
              },
              {
                "title": "Standard",
                "enum": [
                  "standard"
                ]
              },
              {
                "title": "Debug",
                "enum": [
                  "debug"
                ]
              }
            ]
          },
          "energy": {
            "type": "object",
            "properties": {
              "enabled": {
                "title": "Estimate Energy Use (Matter)",
                "type": "boolean",
                "default": false,
                "description": "Publish each spa's estimated power and energy as a Matter outlet, shown in Apple Home's Energy view (iOS/tvOS 27+). Needs Homebridge 2.3+ with Matter enabled on this plugin's bridge. These are estimates from which components are running, not meter readings."
              },
              "heaterWatts": {
                "title": "Heater (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 2800,
                "description": "Power drawn while the heater is heating. Default 2800 W - check your spa's manual or heater label.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "pumpWatts": {
                "title": "Jet Pump, High (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 2200,
                "description": "Power drawn by each jet pump on high (or single-speed). Default 2200 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "pumpLowWatts": {
                "title": "Jet Pump, Low (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 500,
                "description": "Power drawn by each two-speed jet pump on low. Default 500 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "blowerWatts": {
                "title": "Blower (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 900,
                "description": "Power drawn by each air blower. Default 900 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "circulationPumpWatts": {
                "title": "Circulation Pump (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 400,
                "description": "Power drawn by the circulation pump. Default 400 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "lightWatts": {
                "title": "Light (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 10,
                "description": "Power drawn by each spa light. Default 10 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              },
              "standbyWatts": {
                "title": "Standby (W)",
                "type": "number",
                "minimum": 0,
                "maximum": 15000,
                "placeholder": 0,
                "description": "Power always drawn by the controller and electronics, even with everything off. Default 0 W.",
                "condition": {
                  "functionBody": "return (model.options && model.options.energy && model.options.energy.enabled);"
                }
              }
            }
          }
        },
        "required": [
          "logging"
        ]
      }
    },
    "required": [
      "name",
      "credentials"
    ]
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "ControlMySpa Account Info",
      "expandable": true,
      "expanded": true,
      "items": [
        "credentials.email",
        "credentials.password"
      ]
    },
    {
      "type": "fieldset",
      "title": "Spa Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "options.devices",
          "notitle": true,
          "type": "tabarray",
          "title": "{{ value.configDeviceName || value.spaId || 'New Spa' }}",
          "items": [
            "options.devices[].spaId",
            "options.devices[].configDeviceName",
            "options.devices[].hide_device",
            "options.devices[].hideEnergy",
            "options.devices[].showPanelLock",
            "options.devices[].firmware"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Energy Estimate",
      "expandable": true,
      "expanded": false,
      "description": "Estimated power and energy for Apple Home's Energy view, published over Matter.",
      "items": [
        "options.energy.enabled",
        "options.energy.heaterWatts",
        "options.energy.pumpWatts",
        "options.energy.pumpLowWatts",
        "options.energy.blowerWatts",
        "options.energy.circulationPumpWatts",
        "options.energy.lightWatts",
        "options.energy.standbyWatts"
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        "options.refreshRate",
        "options.recordHistory",
        "options.logging"
      ]
    }
  ]
}
